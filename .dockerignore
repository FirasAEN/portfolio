# Everything the build does not need. node_modules especially: it is copied over
# by `npm ci` inside the image, and shipping the host's copy would both bloat
# the context and risk platform-specific binaries leaking in.
node_modules
dist
.astro
.git
.github
.claude
.playwright-screenshots
docs
Dockerfile
.dockerignore

# Deployment scripts are not needed inside the image.
deploy

# The test suite is not part of a deploy build, and leaving it in makes
# `astro check` type-check specs whose devDependencies are no longer installed.
tests
playwright.config.ts
playwright-report
test-results
scripts
LOG.md
