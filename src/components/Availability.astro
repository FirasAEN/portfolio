---
import HexMarker from './HexMarker.astro';
import { site } from '../config/site';

const { open, label } = site.availability;
---

{
	open && (
		<div class="availability">
			<p class="availability-label meta">Availability</p>
			<p class="availability-status">
				<span class="marker" aria-hidden="true"><HexMarker size="0.7rem" /></span>
				{label}
			</p>
		</div>
	)
}

<style>
	/*
	 * A drawing's title block, not a badge. The previous version was a pill with a
	 * border, a fill and a live dot — which is the "Open to work" component, and
	 * recolouring it did not stop it reading as one. Border, background and pill
	 * shape are gone; a rule and a label carry it instead.
	 *
	 * On a CV site this is the one piece of state a reader cannot infer: whether
	 * to bother getting in touch.
	 */
	.availability {
		border-top: 1px solid var(--rule-color);
		padding-top: 0.75rem;
		max-width: 20rem;
	}

	.availability-label {
		margin: 0 0 0.4rem;
	}

	.availability-status {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		margin: 0;
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	/* Wrapped rather than classed directly: Astro scopes a style to the component
	   that declares it, so a class handed to HexMarker would land on an element
	   carrying HexMarker's scope id and this rule would never match. */
	.marker {
		display: flex;
		flex: none;
		/* baseline alignment puts the hexagon on the text's baseline, which sits it
		   slightly low against a cap-height-dominant line; nudge it back up. */
		transform: translateY(0.1rem);
		color: var(--accent-regular);
	}

	/* One opacity breath on the stroke. No expanding halo — that was the ping. */
	@media (prefers-reduced-motion: no-preference) {
		.marker {
			animation: availability-breath 3.2s ease-in-out infinite alternate;
		}
	}

	@keyframes availability-breath {
		/* Floor is 0.55, not lower: this is a functional status indicator, not
		   ambient decoration, and at this size the stroke is sub-pixel — below
		   about half opacity it stops reading at all. */
		from {
			opacity: 0.55;
		}
		to {
			opacity: 1;
		}
	}
</style>
