---
import HexMarker from './HexMarker.astro';
import { site } from '../config/site';

const { open, label } = site.availability;
---

{
	open && (
		<div class="availability">
			<p class="availability-label meta">Availability</p>
			<p class="availability-status">
				<span class="marker" aria-hidden="true"><HexMarker size="0.95rem" /></span>
				<span class="availability-text">{label}</span>
			</p>
		</div>
	)
}

<style>
	/*
	 * A drawing's title block, not a badge. The previous version was a pill with a
	 * border, a fill and a live dot — which is the "Open to work" component, and
	 * recolouring it did not stop it reading as one. Border, background and pill
	 * shape are gone; a rule and a label carry it instead.
	 *
	 * On a CV site this is the one piece of state a reader cannot infer: whether
	 * to bother getting in touch.
	 */
	.availability {
		border-top: 1px solid var(--rule-color);
		padding-top: 0.75rem;
		max-width: 20rem;
	}

	.availability-label {
		margin: 0 0 0.4rem;
	}

	.availability-status {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		margin: 0;
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	/* Wrapped rather than classed directly: Astro scopes a style to the component
	   that declares it, so a class handed to HexMarker would land on an element
	   carrying HexMarker's scope id and this rule would never match. */
	.marker {
		display: flex;
		flex: none;
		/* baseline alignment puts the hexagon on the text's baseline, which sits it
		   slightly low against a cap-height-dominant line; nudge it back up. */
		transform: translateY(0.15rem);
		color: var(--accent-regular);
	}

	.availability-text {
		color: var(--fg-muted);
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Pulse, not the old opacity breath: the hexagon is now 0.95rem, big
		   enough that a scale change reads. Floor is 0.6 — this is a functional
		   status indicator, and the stroke stops registering much below that.
		   The translate is repeated in every keyframe because it is baseline
		   correction, not motion; omitting it would snap the marker down. */
		.marker {
			animation: availability-pulse 2.6s ease-in-out infinite;
		}

		/*
		 * Silver sweep. Two layers: a moving highlight band over a flat base, both
		 * clipped to the glyphs. The base layer is what makes this safe — with a
		 * single no-repeat gradient, every part of the text the image does not
		 * cover would clip to nothing and the words would disappear mid-sweep.
		 *
		 * The highlight is --gray-0, the strongest value in whichever theme is
		 * active: near-white on the dark ground, near-black on the light one. So
		 * the sweep is a bright glint in dark mode and a deeper ink glint in
		 * light mode, and contrast against the ground never drops below the
		 * --fg-muted baseline in either. A literally silver band would have been
		 * a mid-grey streak on the light theme — a contrast hole in the one
		 * sentence a reader needs.
		 */
		.availability-text {
			background-image: linear-gradient(
					100deg,
					transparent 42%,
					var(--gray-0) 50%,
					transparent 58%
				),
				linear-gradient(var(--fg-muted), var(--fg-muted));
			background-size:
				200% 100%,
				100% 100%;
			background-repeat: no-repeat;
			background-position:
				-100% 0,
				0 0;
			background-clip: text;
			-webkit-background-clip: text;
			color: transparent;
			animation: availability-sheen 6s ease-in-out infinite;
		}
	}

	/* Forced colours: background-clip: text over a transparent colour leaves the
	   sentence invisible, because the UA does not repaint gradient layers. */
	@media (forced-colors: active) {
		.availability-text {
			background-image: none;
			color: CanvasText;
			animation: none;
		}
	}

	@keyframes availability-pulse {
		0%,
		100% {
			transform: translateY(0.15rem) scale(1);
			opacity: 0.6;
		}
		50% {
			transform: translateY(0.15rem) scale(1.18);
			opacity: 1;
		}
	}

	/* The band crosses in the first 55% and the rest of the cycle is flat, so it
	   reads as an occasional glint rather than a loading shimmer. */
	@keyframes availability-sheen {
		0% {
			background-position:
				-100% 0,
				0 0;
		}
		55%,
		100% {
			background-position:
				200% 0,
				0 0;
		}
	}
</style>
