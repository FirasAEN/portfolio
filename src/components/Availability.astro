---
import HexMarker from './HexMarker.astro';
import { site } from '../config/site';

const { open, label } = site.availability;
---

{
	open && (
		<p class="availability">
			<span class="marker" aria-hidden="true"><HexMarker size="0.7rem" /></span>
			{label}
		</p>
	)
}

<style>
	/*
	 * A live availability signal: on a CV site this is the one piece of state a
	 * reader actually needs and cannot infer — whether to bother getting in touch.
	 *
	 * It used to be a hardcoded #22c55e circle with Tailwind's animate-ping
	 * written out by hand, borrowed wholesale from another portfolio. Green is a
	 * stronger universal cue than the accent, but the label says "open to ..." in
	 * words, and the accent is already this site's live colour — links, nodes,
	 * index numerals. Borrowed vocabulary was the worse trade.
	 */
	.availability {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.35rem 0.75rem 0.35rem 0.65rem;
		border: 1px solid var(--surface-border);
		border-radius: 0.5rem;
		background-color: var(--surface);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.04em;
		color: var(--fg-muted);
	}

	/* Wrapped rather than classed directly: Astro scopes a style to the component
	   that declares it, so a class handed to HexMarker lands on an element
	   carrying HexMarker's scope id and this rule would never match. */
	.marker {
		display: flex;
		flex: none;
		color: var(--accent-regular);
	}

	/* One opacity breath on the stroke. No expanding halo — that was the ping. */
	@media (prefers-reduced-motion: no-preference) {
		.marker {
			animation: availability-breath 3.2s ease-in-out infinite alternate;
		}
	}

	@keyframes availability-breath {
		/* Floor is 0.55, not lower: this is a functional status indicator, not
		   ambient decoration, and at this size the stroke is sub-pixel — below
		   about half opacity it stops reading at all. */
		from {
			opacity: 0.55;
		}
		to {
			opacity: 1;
		}
	}
</style>
