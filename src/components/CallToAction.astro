---
interface Props {
	href: string;
	/** 'solid' for the one primary action per view; 'ghost' for the rest. */
	variant?: 'solid' | 'ghost' | undefined;
}

const { href, variant = 'ghost' } = Astro.props;
---

<a href={href} class:list={['action', variant]}><slot /></a>

<style>
	/*
	 * The starter's pill button was a saturated gradient lozenge at --text-lg.
	 * At the smaller type scale that read as the loudest thing on every page,
	 * so buttons are now quiet by default and only the primary action fills.
	 */
	.action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		padding: 0.6em 1.1em;
		font-size: var(--text-sm);
		line-height: 1.2;
		white-space: nowrap;
		text-decoration: none;
		border-radius: 0.5rem;
		border: 1px solid var(--surface-border);
		transition: border-color var(--transition-fast), color var(--transition-fast),
			background-color var(--transition-fast);
	}

	.ghost {
		color: var(--fg);
		background-color: var(--surface);
	}

	.ghost:hover,
	.ghost:focus-visible {
		border-color: color-mix(in srgb, var(--accent-regular) 55%, transparent);
		color: var(--accent-regular);
	}

	.solid {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.solid:hover,
	.solid:focus-visible {
		background-color: color-mix(in srgb, var(--accent-regular) 85%, var(--gray-0));
	}
</style>
