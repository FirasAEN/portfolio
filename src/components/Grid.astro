---
// A plain two-column responsive grid. The starter's `variant` prop ('offset' |
// 'small') was never passed by any call site, so it and its CSS are gone.
---

<ul class="grid">
	<slot />
</ul>

<style>
	.grid {
		display: grid;
		grid-auto-rows: auto;
		gap: 1rem;
		list-style: none;
		padding: 0;
	}

	@media (min-width: 50em) {
		.grid {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}
	}
</style>
