---
/*
 * Fonts are self-hosted rather than fetched from fonts.googleapis.com.
 *
 * That removed a render-blocking stylesheet on a third-party origin from the
 * critical path — two preconnects and a round trip before any text could paint
 * — and with it the question of shipping EU visitors' IP addresses to Google,
 * which is a real one for a CV site based in France.
 *
 * Vite fingerprints these and rewrites the URLs base-aware, so they work on
 * both deploy targets without the /portfolio problem a hand-written @font-face
 * would have had.
 *
 * Variable where it exists: one file covers 400-600 instead of three.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { computeUrl } from '../utils/computeUrl';
import { site, pageTitle } from '../config/site';
import { canonicalUrl } from '../config/deploy';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/**
	 * Open Graph type. `profile` describes a PERSON, so it belongs on the home
	 * page alone — every other route was claiming to be the person too. `article`
	 * for the work write-ups, `website` for the rest.
	 */
	ogType?: 'website' | 'profile' | 'article' | undefined;
}

const {
	title = pageTitle(),
	description = site.description,
	ogType = 'website',
} = Astro.props;

/*
 * Absolute URLs, because Open Graph and canonical both require them — a
 * base-relative path is silently ignored by every crawler and every unfurler.
 * Astro.site is the origin from astro.config.mjs; computeUrl adds the /portfolio
 * base, so the two together are the only correct form here.
 */
const canonical = canonicalUrl(Astro.url.pathname);
const ogImage = new URL(computeUrl('/og-image.png'), Astro.site).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!--
	Sharing this link anywhere — Slack, LinkedIn, a DM — produced a blank card,
	which for a CV site is the one place the link actually gets seen. og:image
	must be absolute and should be 1200x630; the card is generated to that size
	and committed rather than rendered at build time, which would mean a
	rendering dependency for one static asset.

	description previously carried `property="og:description"` on the same tag as
	`name="description"`. It works in most parsers by accident, but the two are
	different vocabularies and belong in separate tags.
-->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
{
	ogType === 'profile' && (
		<>
			<meta property="profile:first_name" content="Firas" />
			<meta property="profile:last_name" content="Abed El Nabi" />
		</>
	)
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" type="image/svg+xml" href={computeUrl('/favicon.svg')} />
<link rel="alternate icon" type="image/x-icon" href={computeUrl('/favicon.ico')} />
<link rel="apple-touch-icon" href={computeUrl('/apple-touch-icon.png')} />
<meta name="theme-color" content="#0e7490" />
<script is:inline>
	// This code is inlined in the head to make dark mode instant & blocking.
	const getThemePreference = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};
	const isDark = getThemePreference() === 'dark';
	document.documentElement.classList[isDark ? 'add' : 'remove']('theme-dark');

	if (typeof localStorage !== 'undefined') {
		// Watch the document element and persist user preference when it changes.
		const observer = new MutationObserver(() => {
			const isDark = document.documentElement.classList.contains('theme-dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
	}
</script>
