---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import {computeUrl} from "../utils/computeUrl";
import { site, socials } from '../config/site';


type LinkRoute = { label: string; root: boolean; href: string };
/** Main menu items */
const textLinks: LinkRoute[] = [
	{ label: 'Home', root: true, href: computeUrl('/') },
	{ label: 'Work', root: false, href: computeUrl('/work') },
	{ label: 'Career', root: false, href: `${computeUrl('/')}#timeline` },
	{ label: 'Skills', root: false, href: `${computeUrl('/')}#skills` },
];

const iconLinks = socials;

/** Strip trailing slashes so `/work` and `/work/` compare equal. */
const normalise = (path: string) => path.replace(/\/+$/, '') || '/';

const currentPath = normalise(Astro.url.pathname);

const isCurrentRoute = (item: LinkRoute) => {
	const href = normalise(item.href);
	// Non-root links also match their detail pages, e.g. /work/nx-monorepo.
	return item.root ? currentPath === href : currentPath === href || currentPath.startsWith(`${href}/`);
};

---

<nav>
	<div class="menu-header">
		<a href={computeUrl('/')} class="site-title">
			<Icon icon="terminal-window" color="var(--accent-regular)" size="1.6em" gradient />
			<span class="site-name">{site.name}</span>
		</a>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<div id="menu-content">
		<ul class="nav-items">
			{
				textLinks.map((tl) => (
					<li>
						<a
							aria-current={isCurrentRoute(tl)}
							class:list={[
								'link',
								{active: isCurrentRoute(tl),},
							]}
							data-root={tl.root ? '' : undefined}
							href={tl.href}
						>
							{tl.label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 50em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);

	// --- Sticky-state rule -------------------------------------------------
	const nav = document.querySelector('nav')!;
	const setScrolled = () => nav.classList.toggle('scrolled', window.scrollY > 8);
	setScrolled();
	addEventListener('scroll', setScrolled, { passive: true });

	// --- Scroll-spy --------------------------------------------------------
	// Home links to #sections, so the mark should follow the reader rather than
	// the route. One rAF-throttled calculation rather than an IntersectionObserver
	// plus a scroll handler — two writers to the same state raced, and returning
	// to the top could leave a lower section still marked.
	// Gate on sections that exist on THIS page. Gating on the nav's hash links
	// instead was always true — they are hardcoded — so on /work/* the spy ran
	// with nothing to track, concluded "no section reached", and marked Home
	// active beside the server-rendered Work.
	const targets = [...document.querySelectorAll<HTMLAnchorElement>('.link')]
		.filter((a) => a.hash.length > 1)
		.map((a) => ({ link: a, section: document.querySelector<HTMLElement>(a.hash) }))
		.filter((t): t is { link: HTMLAnchorElement; section: HTMLElement } => t.section != null);

	if (targets.length) {
		// Flagged in the markup, not located by position: `:not([href*="#"])`
		// matches Home and Work both, and only picked Home because it is first.
		const homeLink = document.querySelector<HTMLAnchorElement>('.link[data-root]');

		const update = () => {
			// The section whose top has most recently passed the reading line.
			const line = window.scrollY + window.innerHeight * 0.3;
			let current: HTMLElement | null = null;
			for (const { section } of targets) {
				if (section.offsetTop <= line) current = section;
			}
			// Near the top nothing has been reached yet, so Home is current.
			if (window.scrollY < 120) current = null;

			targets.forEach(({ link, section }) =>
				link.classList.toggle('active', section === current),
			);
			homeLink?.classList.toggle('active', current === null);
		};

		let queued = false;
		const onScroll = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				update();
			});
		};

		update();
		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', onScroll, { passive: true });
	}
</script>

<style>
	/*
	 * Transparent at rest so the hero reads through it, glass once stuck. The
	 * height never changes: a sticky element still occupies its space in normal
	 * flow, so shrinking it on stick would pull everything below it upward and
	 * jump the page at the threshold. The shape change is carried by the surface.
	 */
	nav {
		z-index: 9999;
		position: sticky;
		top: 0;
		font-family: var(--font-mono);
		font-weight: 500;
		margin-bottom: 2rem;
		background-color: transparent;
		border-bottom: 1px solid transparent;
	}

	/* backdrop-filter is declared only here, not on nav. A permanent one forces a
	   compositing layer and re-filters the backdrop every frame, including while
	   the effect is invisible. */
	nav.scrolled {
		background-color: color-mix(in srgb, var(--gray-999) 82%, transparent);
		backdrop-filter: blur(12px);
		border-bottom-color: var(--rule-color);
		box-shadow: 0 12px 28px -24px color-mix(in srgb, var(--gray-100) 55%, transparent);
	}

	/*
	 * Hidden by opacity rather than display or visibility: the element keeps its
	 * space so the left grid column does not change width and nothing shifts when
	 * it appears, and the text stays in the accessibility tree so the site-title
	 * link keeps its accessible name at every scroll position.
	 */
	.site-name {
		opacity: 0;
	}

	nav.scrolled .site-name {
		opacity: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		nav {
			transition: background-color var(--theme-transition),
				border-color var(--theme-transition), box-shadow var(--theme-transition);
		}

		.site-name {
			transform: translateY(-2px);
			transition: opacity var(--theme-transition), transform var(--theme-transition);
		}

		nav.scrolled .site-name {
			transform: none;
		}
	}



	.menu-header {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1.5rem;
	}

	.site-title {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		line-height: 1.1;
		color: var(--fg);
		text-decoration: none;
	}

	.menu-button {
		position: relative;
		display: flex;
		border: 0;
		border-radius: 0.75rem;
		padding: 0.35rem;
		font-size: 1.1rem;
		color: var(--gray-300);
		background: var(--surface);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--fg);
		background: var(--surface);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-button::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: var(--surface-border);
		border-radius: 0.75rem;
		z-index: -1;
	}

	.menu-content {
		position: absolute;
		left: 0;
		right: 0;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-sm);
		line-height: 1.2;
		list-style: none;
		padding: 2rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--surface-border);
	}

	.link {
		display: inline-block;
		color: var(--fg-subtle);
		text-decoration: none;
	}

	.link.active {
		color: var(--fg);
	}

	.menu-footer {
		--icon-size: var(--text-lg);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.5rem 2rem 1.5rem 1.5rem;
		background-color: var(--gray-999);
		border-radius: 0 0 0.75rem 0.75rem;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--accent-dark);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		/* --accent-text-over is for text drawn ON an accent fill; these icons sit
		   on the page background, where it resolves to near-white in the light
		   theme and the icon disappears. --gray-100 flips with the theme. */
		color: var(--gray-100);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	@media (min-width: 50em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 1.75rem 2rem;
			gap: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: var(--text-sm);
		}

		.menu-content {
			display: contents;
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			gap: 1.75rem;
			font-size: var(--text-sm);
			border: 0;
			padding: 0;
			background: none;
			box-shadow: none;
		}

		.link {
			position: relative;
			padding: 0.25rem 0;
			transition: color var(--theme-transition);
		}

		.link:hover,
		.link:focus-visible {
			color: var(--fg);
		}

		/* Current page is marked with a rule under the word, not a filled pill. */
		.link.active {
			color: var(--fg);
			background: none;
		}

		.link.active::after {
			content: '';
			position: absolute;
			left: 0;
			right: 0;
			bottom: -0.35rem;
			height: 1px;
			background: var(--accent-regular);
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			box-shadow: none;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}
	@media (forced-colors: active) {
		.link.active {
			color: SelectedItem;
		}
	}
</style>
