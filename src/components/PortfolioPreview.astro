---
import type { CollectionEntry } from 'astro:content';
import {computeUrl} from "../utils/computeUrl";
import { getCompanyLookup } from "../utils/cv";
import Diagram from './diagrams/Diagram.astro';

interface Props {
	project: CollectionEntry<'work'>;
	/** 1-based position, rendered as the card's index plate. */
	index?: number | undefined;
}

const { data, id } = Astro.props.project;
const index = String(Astro.props.index ?? 0).padStart(3, '0');
const goToLink = computeUrl(`/work/${id}`);

// Label and accent come from the experience collection - one source of truth
// shared with the work filters and the timeline.
const companies = await getCompanyLookup();
const company = data.company || '';
const companyLabel = companies.get(company)?.label || company;
const accentColor = companies.get(company)?.accent || 'var(--accent-regular)';
---

<a class="card ticked" href={goToLink} style={`--card-accent: ${accentColor};`} data-company={company}>
	{data.imgThumbnail ? (
		<div class="card-image-wrapper">
			<img class="card-image" src={computeUrl(data.imgThumbnail)} alt={data.img_alt || ''} loading="lazy" />
			<div class="card-image-overlay"></div>
		</div>
	) : (
		<div class:list={['card-plate', { 'has-diagram': !!data.diagram }]}>
			<span class="card-index">{index}</span>
			{data.diagram && (
				<div class="card-diagram">
					<Diagram id={data.diagram} variant="thumb" />
				</div>
			)}
		</div>
	)}
	<div class="card-content">
		<div class="card-header">
			{company && <span class="company">{companyLabel}</span>}
			<span class="title">{data.title}</span>
		</div>
		<p class="description">{data.description}</p>
		<div class="tags">
			{data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
		</div>
	</div>
</a>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		border: 1px solid var(--surface-border);
		border-radius: var(--radius-lg);
		background-color: var(--surface);
		overflow: hidden;
		transition: border-color var(--transition-medium), transform var(--transition-medium);
	}

	.card:hover::before,
	.card:hover::after {
		border-color: var(--accent-regular);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.card-image-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}

	.card:hover .card-image {
		transform: scale(1.03);
	}

	.card-image-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent 50%, var(--gray-900) 100%);
		pointer-events: none;
	}

	.card-plate {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		padding: 1.25rem;
		aspect-ratio: 16 / 5;
		border-bottom: 1px solid var(--rule-color);
		background:
			linear-gradient(160deg, color-mix(in srgb, var(--card-accent) 10%, transparent), transparent 70%),
			var(--gray-999_40);
	}

	/* The index sits in a hexagon — the same marker the section nodes use. */
	.card-index {
		position: relative;
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		line-height: 1;
		color: var(--card-accent);
		font-variant-numeric: tabular-nums;
	}

	.card-index::before {
		content: '';
		position: absolute;
		inset: 0;
		border: 1px solid color-mix(in srgb, var(--card-accent) 45%, transparent);
		clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
		background: color-mix(in srgb, var(--card-accent) 10%, transparent);
	}

	.card-plate.has-diagram {
		align-items: stretch;
		padding: 1.75rem 1.5rem 1rem;
	}

	/* The six diagrams have different natural ratios; letting each set its own
	   height left the grid ragged. Absolutely positioning the diagram gives it a
	   definite box to fit inside, and the SVG's default preserveAspectRatio
	   centres it there — so every plate is the same height. */
	.card-diagram {
		position: absolute;
		inset: 2.25rem 1.5rem 1rem;
	}

	.card-diagram :global(.diagram-thumb) {
		width: 100%;
		height: 100%;
	}

	.card-plate.has-diagram .card-index {
		position: absolute;
		top: 1rem;
		left: 1.5rem;
		font-size: var(--text-lg);
		z-index: 1;
	}

	/* Below the two-column breakpoint the diagram type is too small to read,
	   so the card falls back to the plain index plate. */
	@media (max-width: 34em) {
		.card-plate.has-diagram {
			aspect-ratio: 16 / 5;
			align-items: flex-end;
		}

		.card-diagram {
			display: none;
		}

		.card-plate.has-diagram .card-index {
			position: static;
			font-size: var(--text-3xl);
		}
	}

	.card-content {
		padding: 1rem 1.25rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		flex: 1;
	}

	.card-header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.company {
		display: inline-flex;
		align-self: flex-start;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-meta);
		color: var(--card-accent);
		background: color-mix(in srgb, var(--card-accent) 12%, transparent);
		padding: 0.15rem 0.55rem;
		border-radius: 999rem;
		line-height: 1.5;
	}

	.title {
		font-family: var(--font-brand);
		font-size: var(--text-xl);
		font-weight: 400;
		letter-spacing: var(--tracking-tight);
		color: var(--gray-100);
		line-height: 1.2;
	}

	.description {
		font-size: var(--text-sm);
		color: var(--gray-300);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: auto;
	}

	.tag {
		font-size: 0.7rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999rem;
		border: 1px solid transparent;
		color: var(--accent-dark);
		background: var(--accent-subtle-overlay);
		font-family: var(--font-body);
		font-weight: 500;
	}


	@media (min-width: 50em) {
		.title {
			font-size: var(--text-xl);
		}

		.card-plate {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		padding: 1.25rem;
		aspect-ratio: 16 / 5;
		border-bottom: 1px solid var(--rule-color);
		background:
			linear-gradient(160deg, color-mix(in srgb, var(--card-accent) 10%, transparent), transparent 70%),
			var(--gray-999_40);
	}

	/* The index sits in a hexagon — the same marker the section nodes use. */
	.card-index {
		position: relative;
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		line-height: 1;
		color: var(--card-accent);
		font-variant-numeric: tabular-nums;
	}

	.card-index::before {
		content: '';
		position: absolute;
		inset: 0;
		border: 1px solid color-mix(in srgb, var(--card-accent) 45%, transparent);
		clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
		background: color-mix(in srgb, var(--card-accent) 10%, transparent);
	}

	.card-plate.has-diagram {
		align-items: stretch;
		padding: 1.75rem 1.5rem 1rem;
	}

	/* The six diagrams have different natural ratios; letting each set its own
	   height left the grid ragged. Absolutely positioning the diagram gives it a
	   definite box to fit inside, and the SVG's default preserveAspectRatio
	   centres it there — so every plate is the same height. */
	.card-diagram {
		position: absolute;
		inset: 2.25rem 1.5rem 1rem;
	}

	.card-diagram :global(.diagram-thumb) {
		width: 100%;
		height: 100%;
	}

	.card-plate.has-diagram .card-index {
		position: absolute;
		top: 1rem;
		left: 1.5rem;
		font-size: var(--text-lg);
		z-index: 1;
	}

	/* Below the two-column breakpoint the diagram type is too small to read,
	   so the card falls back to the plain index plate. */
	@media (max-width: 34em) {
		.card-plate.has-diagram {
			aspect-ratio: 16 / 5;
			align-items: flex-end;
		}

		.card-diagram {
			display: none;
		}

		.card-plate.has-diagram .card-index {
			position: static;
			font-size: var(--text-3xl);
		}
	}

	.card-content {
			padding: 1.25rem 1.5rem 1.5rem;
		}
	}
</style>
