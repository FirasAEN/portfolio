---
import type { CollectionEntry } from 'astro:content';
import {computeUrl} from "../utils/computeUrl";
import { getCompanyLookup } from "../utils/cv";

interface Props {
	project: CollectionEntry<'work'>;
	/** 1-based position, rendered as the card's index plate. */
	index?: number | undefined;
}

const { data, id } = Astro.props.project;
const index = String(Astro.props.index ?? 0).padStart(3, '0');
const goToLink = computeUrl(`/work/${id}`);

// Label and accent come from the experience collection - one source of truth
// shared with the work filters and the timeline.
const companies = await getCompanyLookup();
const company = data.company || '';
const companyLabel = companies.get(company)?.label || company;
const accentColor = companies.get(company)?.accent || 'var(--accent-regular)';
---

<a class="card" href={goToLink} style={`--card-accent: ${accentColor};`} data-company={company}>
	{data.imgThumbnail ? (
		<div class="card-image-wrapper">
			<img class="card-image" src={computeUrl(data.imgThumbnail)} alt={data.img_alt || ''} loading="lazy" />
			<div class="card-image-overlay"></div>
		</div>
	) : (
		<div class="card-plate">
			<span class="card-index">{index}</span>
			{data.diagram && <span class="card-plate-note">diagram</span>}
		</div>
	)}
	<div class="card-content">
		<div class="card-header">
			{company && <span class="company">{companyLabel}</span>}
			<span class="title">{data.title}</span>
		</div>
		<p class="description">{data.description}</p>
		<div class="tags">
			{data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
		</div>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition: box-shadow var(--theme-transition), transform var(--theme-transition);
		overflow: hidden;
	}

	.card:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.card-image-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}

	.card:hover .card-image {
		transform: scale(1.03);
	}

	.card-image-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent 50%, var(--gray-900) 100%);
		pointer-events: none;
	}

	.card-plate {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		padding: 1.25rem;
		aspect-ratio: 16 / 4;
		border-bottom: 1px solid var(--rule-color);
		background:
			linear-gradient(160deg, color-mix(in srgb, var(--card-accent) 10%, transparent), transparent 70%),
			var(--gray-999_40);
	}

	.card-index {
		font-family: var(--font-mono);
		font-size: var(--text-3xl);
		font-weight: 500;
		line-height: 1;
		color: color-mix(in srgb, var(--card-accent) 55%, transparent);
		font-variant-numeric: tabular-nums;
	}

	.card-plate-note {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-meta);
		color: var(--gray-400);
	}

	.card-content {
		padding: 1rem 1.25rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		flex: 1;
	}

	.card-header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.company {
		display: inline-flex;
		align-self: flex-start;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-meta);
		color: var(--card-accent);
		background: color-mix(in srgb, var(--card-accent) 12%, transparent);
		padding: 0.15rem 0.55rem;
		border-radius: 999rem;
		line-height: 1.5;
	}

	.title {
		font-family: var(--font-brand);
		font-size: var(--text-xl);
		font-weight: 400;
		letter-spacing: var(--tracking-tight);
		color: var(--gray-100);
		line-height: 1.2;
	}

	.description {
		font-size: var(--text-sm);
		color: var(--gray-300);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: auto;
	}

	.tag {
		font-size: 0.7rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999rem;
		border: 1px solid transparent;
		color: var(--accent-dark);
		background: var(--accent-subtle-overlay);
		font-family: var(--font-body);
		font-weight: 500;
	}


	@media (min-width: 50em) {
		.title {
			font-size: var(--text-xl);
		}

		.card-plate {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		padding: 1.25rem;
		aspect-ratio: 16 / 4;
		border-bottom: 1px solid var(--rule-color);
		background:
			linear-gradient(160deg, color-mix(in srgb, var(--card-accent) 10%, transparent), transparent 70%),
			var(--gray-999_40);
	}

	.card-index {
		font-family: var(--font-mono);
		font-size: var(--text-3xl);
		font-weight: 500;
		line-height: 1;
		color: color-mix(in srgb, var(--card-accent) 55%, transparent);
		font-variant-numeric: tabular-nums;
	}

	.card-plate-note {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-meta);
		color: var(--gray-400);
	}

	.card-content {
			padding: 1.25rem 1.5rem 1.5rem;
		}
	}
</style>
