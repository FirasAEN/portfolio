---
import HexMarker from './HexMarker.astro';

interface Props {
	/** Two-digit index shown inside the node, e.g. "02". */
	index: string;
	label: string;
	/** Omit the connector above on the first node of a page. */
	first?: boolean | undefined;
}

const { index, label, first = false } = Astro.props;
---

<div class:list={['node', { first }]}>
	<span class="marker" aria-hidden="true">
		<span class="hex"><HexMarker size="100%" /></span>
		<span class="index">{index}</span>
	</span>
	<p class="label meta">{label}</p>
	<span class="rule" aria-hidden="true"></span>
</div>

<style>
	/*
	 * Section headings are nodes on a vertical spine — the same node-and-edge
	 * language as the architecture diagrams, and a nod to the lineage graphs the
	 * work is actually about. The connector is drawn upward from each node, so
	 * the spine is continuous without needing a wrapper element.
	 */
	.node {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin-bottom: 2rem;
	}

	/*
	 * left reads --marker-size, the shared token. It previously read --node-size,
	 * which was declared on the child .marker — a parent cannot read a child's
	 * custom property, so the calc() was invalid and left fell back to 0. That
	 * was the whole 16px offset between this connector and the hexagon.
	 */
	.node::before {
		content: '';
		position: absolute;
		left: calc(var(--marker-size) / 2 - 0.5px);
		bottom: calc(100% + 0.35rem);
		width: 1px;
		height: 5rem;
		background: linear-gradient(to bottom, transparent, var(--rule-color));
	}

	.node.first::before {
		display: none;
	}

	.marker {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--marker-size);
		height: var(--marker-size);
		flex: none;
		color: var(--accent-regular);
	}

	/*
	 * HexMarker is wrapped rather than given this class directly: Astro scopes a
	 * style to the component that declares it, so a class passed to a child lands
	 * on an element carrying the child's scope id and the parent's rule never
	 * matches. The wrapper is owned here, so it does.
	 */
	.hex {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.index {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1;
		color: var(--accent-regular);
		font-variant-numeric: tabular-nums;
	}

	.label {
		flex: none;
		color: var(--fg);
	}

	.rule {
		flex: 1;
		height: 1px;
		background: var(--rule-color);
	}
</style>
