---
import HexMarker from './HexMarker.astro';

interface Props {
	/** Two-digit index shown inside the node, e.g. "02". */
	index: string;
	label: string;
	/** Omit the connector above on the first node of a page. */
	first?: boolean | undefined;
}

const { index, label, first = false } = Astro.props;
---

<div class:list={['node', { first }]}>
	<span class="marker" aria-hidden="true">
		<span class="hex"><HexMarker size="100%" /></span>
		<span class="index">{index}</span>
	</span>
	<h2 class="label">{label}</h2>
	<span class="rule" aria-hidden="true"></span>
</div>

<style>
	/*
	 * Section headings are nodes on a vertical spine — the same node-and-edge
	 * language as the architecture diagrams, and a nod to the lineage graphs the
	 * work is actually about.
	 *
	 * The node draws no line of its own. The spine is one element on the page
	 * (.spine-line in index.astro), masked open at each marker, so there is
	 * nothing here to keep in step with it.
	 */
	.node {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin-bottom: 2rem;
	}



	.marker {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--marker-size);
		height: var(--marker-size);
		flex: none;
		color: var(--accent-regular);
	}

	/*
	 * HexMarker is wrapped rather than given this class directly: Astro scopes a
	 * style to the component that declares it, so a class passed to a child lands
	 * on an element carrying the child's scope id and the parent's rule never
	 * matches. The wrapper is owned here, so it does.
	 */
	.hex {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.index {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1;
		color: var(--accent-regular);
		font-variant-numeric: tabular-nums;
	}

	/*
	 * A real h2, not a styled paragraph. The document outline previously ran
	 * h1 -> h3 with nothing between, so section navigation was broken for screen
	 * readers in the same way the visual hierarchy was: the label rendered at
	 * 12px mono, smaller than the 25px entry headings inside it and smaller than
	 * their body copy. The global h2 rule supplies --font-brand at --text-3xl,
	 * which lands at 32px — above the entries, below the 48px hero.
	 */
	.label {
		flex: none;
		margin: 0;
		color: var(--fg);
	}

	.rule {
		flex: 1;
		height: 1px;
		background: var(--rule-color);
	}
</style>
