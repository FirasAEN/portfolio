---
import { getEvidencedSkills } from '../utils/cv';
import { computeUrl } from '../utils/computeUrl';

const tiers = await getEvidencedSkills();
---

<div class="tiers">
	{
		tiers.map((tier) => (
			<section class="tier">
				<div class="tier-head">
					<h3 class="tier-label">{tier.label}</h3>
					<span class="tier-rule" />
				</div>
				<div class="groups">
					{tier.groups.map((group) => (
						<div class="group">
							<p class="group-name meta">{group.name}</p>
							<ul class="chips">
								{group.skills.map((skill) =>
									skill.projects.length > 0 ? (
										<li>
											<a
												class="chip chip-linked"
												href={computeUrl(`/work/${skill.projects[0]!.id}`)}
												title={`Used in: ${skill.projects.map((p) => p.title).join(', ')}`}
											>
												{skill.name}
												<span class="count">{skill.projects.length}</span>
											</a>
										</li>
									) : (
										<li><span class="chip">{skill.name}</span></li>
									),
								)}
							</ul>
						</div>
					))}
				</div>
			</section>
		))
	}
	<p class="legend meta">
		A number means the technology is used in that many projects here — follow the chip to one.
	</p>
</div>

<style>
	.tiers {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.tier-head {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin-bottom: 1.25rem;
	}

	.tier-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-meta);
		color: var(--accent-regular);
		white-space: nowrap;
	}

	.tier-rule {
		flex: 1;
		height: 1px;
		background: var(--rule-color);
	}

	.groups {
		display: grid;
		gap: 1.25rem;
	}

	.group-name {
		margin-bottom: 0.5rem;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	/* Linked chips carry a count of the projects that evidence them; the rest
	   are honestly plain, so the eye can tell the difference at a glance. */
	.chip-linked {
		text-decoration: none;
		color: var(--fg);
		border-color: color-mix(in srgb, var(--accent-regular) 35%, transparent);
	}

	.count {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1;
		padding: 0.15rem 0.3rem;
		border-radius: 0.25rem;
		color: var(--accent-regular);
		background: color-mix(in srgb, var(--accent-regular) 14%, transparent);
		font-variant-numeric: tabular-nums;
	}

	.legend {
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule-color);
	}

	@media (min-width: 50em) {
		.groups {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem 2.5rem;
		}
	}
</style>
