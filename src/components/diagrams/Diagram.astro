---
import Hexagonal from './Hexagonal.astro';
import NxGraph from './NxGraph.astro';
import OauthFlow from './OauthFlow.astro';
import DslPipeline from './DslPipeline.astro';
import MigrationPath from './MigrationPath.astro';
import SparkPipeline from './SparkPipeline.astro';
import WorkflowModel from './WorkflowModel.astro';
import DesignSystemLayers from './DesignSystemLayers.astro';
import OnboardingPath from './OnboardingPath.astro';
import StreamingState from './StreamingState.astro';
import BlePairing from './BlePairing.astro';

/**
 * Renders a hand-authored architecture diagram by id.
 *
 * Diagrams exist only where a picture teaches something prose does not. Entries
 * without one render as a typographic card — an image is evidence or it is
 * absent.
 */
const diagrams = {
	hexagonal: Hexagonal,
	'nx-graph': NxGraph,
	'oauth-flow': OauthFlow,
	'dsl-pipeline': DslPipeline,
	'migration-path': MigrationPath,
	'spark-pipeline': SparkPipeline,
	'workflow-model': WorkflowModel,
	'design-system': DesignSystemLayers,
	'onboarding-path': OnboardingPath,
	'streaming-state': StreamingState,
	'ble-pairing': BlePairing,
} as const;

type DiagramId = keyof typeof diagrams;

interface Props {
	id: string;
	caption?: string | undefined;
	/** 'thumb' crops to the structural region, for card previews. */
	variant?: 'full' | 'thumb' | undefined;
}

const { id, caption, variant = 'full' } = Astro.props;
const Component = diagrams[id as DiagramId];
---

{
	Component &&
		(variant === 'thumb' ? (
			<Component variant="thumb" />
		) : (
			<figure class="figure">
				<Component />
				{caption && <figcaption>{caption}</figcaption>}
			</figure>
		))
}
