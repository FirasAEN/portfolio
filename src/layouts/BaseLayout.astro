---
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { backgroundVarsCss } from '../styles/backgrounds';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
		<style is:inline set:html={backgroundVarsCss}></style>
	</head>
	<body>
		<div class="stack sheet">
			<Nav />
			<slot />
			<Footer />
		</div>

		<script>
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

		<style>
			/*
			 * The page is a drafting sheet: a fine grid, a heavier rule every
			 * fifth cell, and a soft vignette so the grid fades at the edges
			 * rather than stopping abruptly.
			 */
			.sheet {
				position: relative;
				min-height: 100%;
				isolation: isolate;
			}

			.sheet::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				background-color: var(--gray-999);
				background-image:
					linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
					linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
				background-size: var(--grid-size) var(--grid-size);
				mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 92%);
			}

			/* Paper grain, so the sheet reads as material rather than as CSS. */
			.sheet::after {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				background: var(--bg-image-noise) top center/200px repeat;
				opacity: 0.02;
				pointer-events: none;
			}

			@media (forced-colors: active) {
				.sheet::before,
				.sheet::after {
					background: none;
				}
			}
		</style>
	</body>
</html>
