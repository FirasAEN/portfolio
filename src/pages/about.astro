---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Francois ABED EL NABI" description="About Francois ABED EL NABI — Software Development Engineer">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			></Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I'm a Software Development Engineer with a unique path — from particle physics and
						computational material science to full-stack web development. After completing a PhD
						in computational science, I retrained as a Java developer and have spent the past 8+
						years building enterprise web applications.
					</p>
					<p>
						Currently based in Grenoble, France, I serve as Tech Lead at Adobis Group, where I
						lead a team of 5 developers building complex enterprise platforms. My work spans the
						full stack — from designing DDD/Hexagonal back-end architectures to building Angular
						micro-frontends with Nx and Module Federation.
					</p>
					<p>
						Prior to Adobis, I worked as a consultant at Capgemini-Sogeti High Tech (for Schneider
						Electric and EATON) and at VISEO Technologies (for Politecnico di Milano), gaining
						experience across IoT, energy management, data center monitoring, and augmented reality.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p><strong>Java Software Developer Bootcamp</strong> — M2I, Grenoble — 2016–2017</p>
					<p><strong>PhD in Computational Material Science</strong> — Université de Poitiers / Institut Pprime — 2012–2016</p>
					<p><strong>Masters in Particle Physics</strong> — Université Grenoble Alpes — 2009–2012</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p><strong>Languages:</strong> Java, TypeScript, JavaScript, C#, HTML, CSS/SCSS</p>
					<p><strong>Frameworks:</strong> Angular, React, Spring Boot, Spring MVC, Ionic, NgRx, RxJS</p>
					<p><strong>Architecture:</strong> DDD, Hexagonal, Micro-frontends, Module Federation, Nx Monorepo</p>
					<p><strong>Tools & CI/CD:</strong> Git, Docker, Jenkins, GitHub Actions, Webpack, Storybook</p>
					<p><strong>Databases:</strong> PostgreSQL, ElasticSearch, MongoDB</p>
					<p><strong>Auth & Security:</strong> Keycloak, OAuth2/OIDC, JWT</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Languages</h2>
				<div class="content">
					<p><strong>Fluent:</strong> English, French, Arabic</p>
					<p><strong>Intermediate:</strong> German</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
		border-inline-start: 3px solid var(--accent-regular);
		padding-inline-start: 1.25rem;
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--accent-regular);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
			border-inline-start: none;
			padding-inline-start: 0;
		}

		.section-title {
			border-inline-start: 3px solid var(--accent-regular);
			padding-inline-start: 1.25rem;
		}
	}
</style>
