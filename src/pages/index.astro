---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import SkillsEvidenced from '../components/SkillsEvidenced.astro';
import SectionNode from '../components/SectionNode.astro';
import HexMarker from '../components/HexMarker.astro';
import Availability from '../components/Availability.astro';
import { computeUrl } from '../utils/computeUrl';
import { getFeaturedWork, getExperience, getWorkForCompany } from '../utils/cv';
import { site } from '../config/site';

// Home carries the whole argument: hook, proof, arc, evidenced skills, contact.
// Timeline and About used to be separate routes restating the same facts.
const projects = await getFeaturedWork();
const experience = await getExperience();
const companyWork = new Map(
	await Promise.all(experience.map(async (e) => [e.id, await getWorkForCompany(e.id)] as const)),
);
// Chronological: physics, then the PhD, then retraining as a developer. The
// sequence is the story, so it reads forwards rather than newest-first.
const education = (await getCollection('education')).sort(
	(a, b) => a.data.start.valueOf() - b.data.start.valueOf(),
);
const languages = (await getCollection('languages')).sort((a, b) => a.data.rank - b.data.rank);

// The hero mentions the doctorate in prose and links straight to the thesis
// itself. The Career entry keeps the split: its title points at the theses.fr
// record, "read the thesis" at the same full text used here. Both URLs come from
// the one education entry, so neither is written twice.
const phd = education.find((entry) => entry.id === 'phd');

// Facts strip: derived, not asserted. Years come from the earliest role start.
const allWork = await getCollection('work');
const earliestStart = experience.reduce(
	(min, e) => (e.data.start < min ? e.data.start : min),
	experience[0]!.data.start,
);
const years = Math.floor((Date.now() - earliestStart.valueOf()) / (365.25 * 24 * 3600 * 1000));
const facts = [
	{ value: String(years), label: 'years building' },
	{ value: '5', label: 'engineers led' },
	{ value: String(allWork.length), label: 'projects here' },
];

const YEAR = { year: 'numeric' } as const;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const period = (start: Date, end: Date | null) => `${fmt(start)} – ${end ? fmt(end) : 'Present'}`;
---

<BaseLayout>
	<div class="spine">
		<!-- 1 · Hook -->
		<header class="wrapper hero" id="top">
			<Availability />
			<p class="meta">{site.role} · {site.location}</p>
			<h1>{site.heroName}</h1>
			<hr class="rule" />
			<p class="lede">
				I model business domains the way I used to model materials — decompose the messy thing
				until the structure shows, then build something that survives contact with reality.
			</p>
			<p class="hero-detail">
				{
					phd?.data.fullText ? (
						<a
							class="edu-link"
							href={phd.data.fullText.url}
							target="_blank"
							rel="noopener noreferrer"
						>PhD in computational material science</a>
					) : (
						'PhD in computational material science'
					)
				}, retrained as a Java developer, {years} years building enterprise software. Today I lead
				a team of five and own the architecture rather than only implementing it.
			</p>
			<dl class="facts">
				{
					facts.map((fact) => (
						<div class="fact">
							<dt class="fact-value">{fact.value}</dt>
							<dd class="fact-label meta">{fact.label}</dd>
						</div>
					))
				}
			</dl>
			<div class="hero-actions">
				<CallToAction href={computeUrl('/work')} variant="solid">
					See the work
					<Icon icon="arrow-right" size="1.2em" />
				</CallToAction>
				{
					site.cv.href && (
						<CallToAction href={computeUrl(site.cv.href)}>
							{site.cv.label}
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
					)
				}
			</div>
		</header>

		<!-- 2 · Proof -->
		<section class="wrapper section" id="work" data-reveal>
			<SectionNode index="01" label="Selected work" />
			<Grid>
				{
					projects.map((project, i) => (
						<li>
							<PortfolioPreview project={project} index={i + 1} />
						</li>
					))
				}
			</Grid>
			<div class="section-action">
				<CallToAction href={computeUrl('/work')}>
					All {(await getCollection('work')).length} projects
					<Icon icon="arrow-right" size="1.2em" />
				</CallToAction>
			</div>
		</section>

		<!-- 3 · Arc -->
		<section class="wrapper section" id="timeline" data-reveal>
			<SectionNode index="02" label="Career" />
			<ol class="timeline">
				{
					experience.map((entry) => (
						<li class="entry">
							<span class="entry-marker"><HexMarker size="12px" /></span>
							<div class="entry-when">
								<span class="meta">{period(entry.data.start, entry.data.end)}</span>
							</div>
							<div class="entry-what">
								<h3>{entry.data.company}</h3>
								<p class="entry-role">{entry.data.role} — {entry.data.location}</p>
								<p class="entry-summary">{entry.data.summary}</p>
								{(companyWork.get(entry.id) ?? []).length > 0 && (
									<div class="entry-links">
										{(companyWork.get(entry.id) ?? []).map((work) => (
											<a href={computeUrl(`/work/${work.id}`)} class="entry-pill">
												{work.data.title}
											</a>
										))}
									</div>
								)}
							</div>
						</li>
					))
				}
				<li class="entry">
							<span class="entry-marker"><HexMarker size="12px" /></span>
					<div class="entry-when">
						<span class="meta">
							{education[0]!.data.start.toLocaleDateString('en-GB', YEAR)} – {
								education.at(-1)!.data.end.toLocaleDateString('en-GB', YEAR)
							}
						</span>
					</div>
					<div class="entry-what">
						<h3>Education</h3>
						{
							education.map((edu) => (
								<p class="entry-summary">
									{edu.data.url ? (
										<a
											class="edu-link"
											href={edu.data.url}
											target="_blank"
											rel="noopener noreferrer"
										>
											<strong>{edu.data.title}</strong>
										</a>
									) : (
										<strong>{edu.data.title}</strong>
									)}{' '}
									— {edu.data.institution},{' '}
									{`${edu.data.start.toLocaleDateString('en-GB', YEAR)}–${edu.data.end.toLocaleDateString('en-GB', YEAR)}`}
									{edu.data.fullText && (
										<>
											{' · '}
											<a
												class="edu-link"
												href={edu.data.fullText.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{edu.data.fullText.label}
											</a>
											{edu.data.fullText.bytes && (
												<span class="edu-note">
													{' '}(PDF, {(edu.data.fullText.bytes / 1e6).toFixed(1)} MB)
												</span>
											)}
										</>
									)}
								</p>
							))
						}
					</div>
				</li>
			</ol>
		</section>

		<!-- 4 · Skills, evidenced by the projects that used them -->
		<section class="wrapper section" id="skills" data-reveal>
			<SectionNode index="03" label="Skills" />
			<SkillsEvidenced />
		</section>

		<!-- 5 · Contact -->
		<section class="wrapper section" id="about" data-reveal>
			<SectionNode index="04" label="Languages" />
			<p class="languages">
				{languages.map((l) => <span><strong>{l.data.name}</strong> {l.data.level}</span>)}
			</p>
		</section>

		<ContactCTA />
	</div>

	<script>
		// Reveal-on-scroll. `data-reveal-state` is both the init guard and the hook
		// the verification asserts on: "armed" while watching, "done" once every
		// element has revealed and the observer has been dropped.
		const root = document.documentElement;

		if (!root.dataset.revealState) {
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
				// No hiding and no observer at all — the content is already visible.
				root.dataset.revealState = 'done';
			} else {
				root.classList.add('reveal-armed');

				const els = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
				let remaining = els.length;

				if (remaining === 0) {
					root.dataset.revealState = 'done';
				} else {
					root.dataset.revealState = 'armed';

					const observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								entry.target.classList.add('is-revealed');
								// Released as each element lands, not all at the end.
								observer.unobserve(entry.target);
								remaining -= 1;
							}
							if (remaining === 0) {
								// Nothing left to watch: no live observer remains.
								observer.disconnect();
								root.dataset.revealState = 'done';
							}
						},
						{ threshold: 0, rootMargin: '0px 0px -10% 0px' },
					);

					els.forEach((el) => observer.observe(el));
				}
			}
		}
	</script>
</BaseLayout>

<style>
	.spine {
		display: flex;
		flex-direction: column;
		gap: 5rem;
	}

	.section {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	/* --- Hook ---
	   Single column since the portrait was removed; the facts strip carries the
	   weight the photo used to. */
	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
		/* nav already contributes 2rem of margin below itself, on every page.
		   The hero adding 5rem on top of that put 112px between the header and
		   the first thing you read. */
		padding-top: 1rem;
	}

	.hero h1 {
		font-size: var(--text-5xl);
		line-height: 0.95;
	}

	.hero .rule {
		width: 100%;
		margin: 0.5rem 0;
	}

	.hero .lede {
		max-width: 34ch;
	}

	.hero-detail {
		color: var(--gray-300);
		max-width: 58ch;
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
		margin: 1rem 0 0;
	}

	.fact-value {
		font-family: var(--font-mono);
		font-size: var(--text-2xl);
		font-weight: 500;
		line-height: 1;
		color: var(--accent-regular);
		font-variant-numeric: tabular-nums;
	}

	.fact {
		padding-left: 0.875rem;
		border-left: 1px solid var(--rule-color);
	}

	.fact-label {
		margin: 0.4rem 0 0;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		padding-top: 1rem;
	}

	.section-action {
		display: flex;
		justify-content: flex-start;
	}

	/* --- Arc --- */
	.timeline {
		list-style: none;
		padding: 0 0 0 var(--marker-size);
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	/* Roles are nodes on an edge running down the column: the career as a
	   lineage graph, matching the schematics the work is made of. */
	.entry {
		position: relative;
		display: grid;
		gap: 0.5rem;
		padding: 0 0 2.25rem 0;
	}

	/*
	 * Marker and spine both derive from --marker-size, so the spine is centred on
	 * the marker by construction. Writing the two offsets independently — which
	 * is what this was — is how they ended up 1.5px apart.
	 *
	 * The shape is HexMarker, the same hexagon used beside section headings. It
	 * was a rotated square here because an earlier clip-path hexagon sliced its
	 * own border into fragments; an SVG path has no border to slice.
	 */
	/* Wrapped rather than classed directly: Astro scopes styles to the declaring
	   component, so a class passed to HexMarker lands on an element carrying
	   HexMarker's scope id and this rule would never match it. */
	.entry-marker {
		display: block;
		position: absolute;
		left: calc(-1 * var(--marker-size) / 2 - 6px);
		top: 0.35rem;
		color: var(--accent-regular);
	}

	.entry::after {
		content: '';
		position: absolute;
		left: calc(-1 * var(--marker-size) / 2 - 0.5px);
		top: 1.35rem;
		bottom: 0;
		width: 1px;
		background: var(--rule-color);
	}

	.entry:last-child::after {
		display: none;
	}

	.entry-what h3 {
		font-size: var(--text-2xl);
	}

	.entry-when .meta {
		white-space: nowrap;
	}

	.entry-role {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--gray-400);
		margin: 0.35rem 0 0.75rem;
	}

	.entry-summary {
		color: var(--gray-300);
		max-width: 62ch;
	}

	.entry-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.entry-pill {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--gray-300);
		text-decoration: none;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--rule-color);
		border-radius: 999rem;
		transition: border-color var(--transition-fast), color var(--transition-fast);
	}

	.entry-pill:hover,
	.entry-pill:focus-visible {
		border-color: var(--accent-regular);
		color: var(--accent-regular);
	}

	/*
	 * Both education links leave the site, so they open in a new tab: a reader
	 * dipping into a 192-page thesis has not finished with this page. rel carries
	 * noopener (the new tab must not get a handle on this window) and noreferrer.
	 *
	 * The size is stated because the full text is 17.5 MB. The server sends
	 * Content-Disposition: inline, so it opens in the browser's PDF viewer rather
	 * than saving — but the transfer happens either way, which is what matters on
	 * a phone.
	 */
	.edu-link {
		color: inherit;
		text-decoration-color: var(--rule-color);
		text-underline-offset: 0.2em;
		transition: text-decoration-color var(--transition-fast), color var(--transition-fast);
	}

	.edu-link:hover,
	.edu-link:focus-visible {
		color: var(--accent-regular);
		text-decoration-color: currentColor;
	}

	.edu-note {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--fg-subtle);
	}

	.languages {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		.spine {
			gap: 7rem;
		}

		.hero {
			padding-top: 2rem;
			gap: 1.75rem;
		}

		.hero .lede {
			max-width: 44ch;
		}

		.entry {
			grid-template-columns: 11.5rem 1fr;
			gap: 2rem;
		}
	}
</style>
