---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import SkillsEvidenced from '../components/SkillsEvidenced.astro';
import SectionNode from '../components/SectionNode.astro';
import PersonSchema from '../components/PersonSchema.astro';
import HexMarker from '../components/HexMarker.astro';
import Availability from '../components/Availability.astro';
import { computeUrl } from '../utils/computeUrl';
import { getFeaturedWork, getExperience, getWorkForCompany } from '../utils/cv';
import { site } from '../config/site';

// Home carries the whole argument: hook, proof, arc, evidenced skills, contact.
// Timeline and About used to be separate routes restating the same facts.
const projects = await getFeaturedWork();
const experience = await getExperience();
const companyWork = new Map(
	await Promise.all(experience.map(async (e) => [e.id, await getWorkForCompany(e.id)] as const)),
);
// Chronological: physics, then the PhD, then retraining as a developer. The
// sequence is the story, so it reads forwards rather than newest-first.
const education = (await getCollection('education')).sort(
	(a, b) => a.data.start.valueOf() - b.data.start.valueOf(),
);
const languages = (await getCollection('languages')).sort((a, b) => a.data.rank - b.data.rank);

// The hero mentions the doctorate in prose and links straight to the thesis
// itself. The Career entry keeps the split: its title points at the theses.fr
// record, "read the thesis" at the same full text used here. Both URLs come from
// the one education entry, so neither is written twice.
const phd = education.find((entry) => entry.id === 'phd');

// Facts strip: derived, not asserted. Years come from the earliest role start.
const allWork = await getCollection('work');
// Derived from site.careerStart rather than the earliest entry in experience.yaml:
// that entry is the first *professional* role, which leaves out the retraining
// year and reads one lower than the career actually is.
const years = Math.floor(
	(Date.now() - new Date(site.careerStart).valueOf()) / (365.25 * 24 * 3600 * 1000),
);
const facts = [
	{ value: String(years), label: 'years building' },
	{ value: '5', label: 'engineers led' },
	{ value: String(allWork.length), label: 'projects here' },
];

const YEAR = { year: 'numeric' } as const;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const period = (start: Date, end: Date | null) => `${fmt(start)} – ${end ? fmt(end) : 'Present'}`;
---

<BaseLayout ogType="profile">
	<PersonSchema />
	<div class="spine">
		<div class="spine-rail wrapper" aria-hidden="true"><span class="spine-beam"><span class="spine-line"></span><span class="spine-flare"></span></span></div>
		<!-- 1 · Hook -->
		<header class="wrapper hero" id="top">
			<div class="hero-head">
				<div class="hero-intro">
					<p class="meta">{site.role} · {site.location}</p>
					<h1>{site.heroName}</h1>
				</div>
				<Availability />
			</div>
			<hr class="rule" />
			<p class="lede">
				I model business domains the way I used to model materials — decompose the messy thing
				until the structure shows, then build something that survives contact with reality.
			</p>
			<p class="hero-detail">
				{
					phd?.data.fullText ? (
						<a
							class="edu-link"
							href={phd.data.fullText.url}
							target="_blank"
							rel="noopener noreferrer"
						>PhD in computational material science</a>
					) : (
						'PhD in computational material science'
					)
				}, retrained as a Java developer, {years} years building software and most of that
				in the enterprise. Today I lead a team of five and own the architecture rather than
				only implementing it.
			</p>
			<dl class="facts">
				{
					facts.map((fact) => (
						<div class="fact">
							<dt class="fact-value">{fact.value}</dt>
							<dd class="fact-label meta">{fact.label}</dd>
						</div>
					))
				}
			</dl>
			<div class="hero-actions">
				<CallToAction href={computeUrl('/work')} variant="solid">
					See the work
					<Icon icon="arrow-right" size="1.2em" />
				</CallToAction>
				{
					site.cv.href && (
						<CallToAction href={computeUrl(site.cv.href)}>
							{site.cv.label}
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
					)
				}
			</div>
			<div class="spine-start" aria-hidden="true"></div>
		</header>

		<!-- 2 · Proof -->
		<section class="wrapper section" id="work" data-reveal>
			<SectionNode index="01" label="Selected work" />
			<Grid>
				{
					projects.map((project, i) => (
						<li>
							<PortfolioPreview project={project} index={i + 1} />
						</li>
					))
				}
			</Grid>
			<div class="section-action">
				<CallToAction href={computeUrl('/work')}>
					All {(await getCollection('work')).length} projects
					<Icon icon="arrow-right" size="1.2em" />
				</CallToAction>
			</div>
		</section>

		<!-- 3 · Arc -->
		<section class="wrapper section" id="timeline" data-reveal>
			<SectionNode index="02" label="Career" />
			<ol class="timeline">
				{
					experience.map((entry) => (
						<li class="entry">
							<span class="entry-marker"><HexMarker size="12px" /></span>
							<div class="entry-when">
								<span class="meta">{period(entry.data.start, entry.data.end)}</span>
							</div>
							<div class="entry-what">
								<h3>{entry.data.company}</h3>
								<p class="entry-role">{entry.data.role} — {entry.data.location}</p>
								<p class="entry-summary">{entry.data.summary}</p>
								{(companyWork.get(entry.id) ?? []).length > 0 && (
									<div class="entry-links">
										{(companyWork.get(entry.id) ?? []).map((work) => (
											<a href={computeUrl(`/work/${work.id}`)} class="entry-pill">
												{work.data.title}
											</a>
										))}
									</div>
								)}
							</div>
						</li>
					))
				}
				<li class="entry">
							<span class="entry-marker"><HexMarker size="12px" /></span>
					<div class="entry-when">
						<span class="meta">
							{education[0]!.data.start.toLocaleDateString('en-GB', YEAR)} – {
								education.at(-1)!.data.end.toLocaleDateString('en-GB', YEAR)
							}
						</span>
					</div>
					<div class="entry-what">
						<h3>Education</h3>
						{
							education.map((edu) => (
								<p class="entry-summary">
									{edu.data.url ? (
										<a
											class="edu-link"
											href={edu.data.url}
											target="_blank"
											rel="noopener noreferrer"
										>
											<strong>{edu.data.title}</strong>
										</a>
									) : (
										<strong>{edu.data.title}</strong>
									)}{' '}
									— {edu.data.institution},{' '}
									{`${edu.data.start.toLocaleDateString('en-GB', YEAR)}–${edu.data.end.toLocaleDateString('en-GB', YEAR)}`}
									{edu.data.fullText && (
										<>
											{' · '}
											<a
												class="edu-link"
												href={edu.data.fullText.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{edu.data.fullText.label}
											</a>
											{edu.data.fullText.bytes && (
												<span class="edu-note">
													{' '}(PDF, {(edu.data.fullText.bytes / 1e6).toFixed(1)} MB)
												</span>
											)}
										</>
									)}
								</p>
							))
						}
					</div>
				</li>
			</ol>
		</section>

		<!-- 4 · Skills, evidenced by the projects that used them -->
		<section class="wrapper section" id="skills" data-reveal>
			<SectionNode index="03" label="Skills" />
			<SkillsEvidenced />
		</section>

		<!-- 5 · Contact -->
		<section class="wrapper section" id="about" data-reveal>
			<SectionNode index="04" label="Languages" />
			<p class="languages">
				{languages.map((l) => <span><strong>{l.data.name}</strong> {l.data.level}</span>)}
			</p>
		</section>

		<ContactCTA />
	</div>

	<script>
		// Reveal-on-scroll. `data-reveal-state` is both the init guard and the hook
		// the verification asserts on: "armed" while watching, "done" once every
		// element has revealed and the observer has been dropped.
		const root = document.documentElement;

		if (!root.dataset.revealState) {
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
				// No hiding and no observer at all — the content is already visible.
				root.dataset.revealState = 'done';
			} else {
				root.classList.add('reveal-armed');

				const els = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
				let remaining = els.length;

				if (remaining === 0) {
					root.dataset.revealState = 'done';
				} else {
					root.dataset.revealState = 'armed';

					const observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								entry.target.classList.add('is-revealed');
								// Released as each element lands, not all at the end.
								observer.unobserve(entry.target);
								remaining -= 1;
							}
							if (remaining === 0) {
								// Nothing left to watch: no live observer remains.
								observer.disconnect();
								root.dataset.revealState = 'done';
							}
						},
						{ threshold: 0, rootMargin: '0px 0px -10% 0px' },
					);

					els.forEach((el) => observer.observe(el));
				}
			}
		}
	</script>

	<script>
		/*
		 * The spine controller.
		 *
		 * One line, one flare. Three things CSS cannot do on its own and which are
		 * therefore here:
		 *
		 *  1. LENGTH. The spine is drawn as far down as the reader has been, so
		 *     before any scroll it is the short stub under the hero and it extends
		 *     as they go. That is a document measurement, not a style.
		 *
		 *  2. MASK. The line runs behind every marker, and a 1px line through a
		 *     hollow hexagon would cross the numeral inside it. One linear-gradient
		 *     mask with a transparent band per marker opens the line exactly where
		 *     each marker sits — so the flare disappears into a node and comes out
		 *     the other side, which is the whole point of the gesture.
		 *
		 *  3. FLARE TIMING. Each node lights when the flare reaches it. Its delay
		 *     is its own offset as a fraction of the current length, so it changes
		 *     every time the spine grows.
		 *
		 * Everything is recomputed on a debounced scroll-end rather than per frame:
		 * the length is a cheap custom property written on every scroll, but the
		 * animations restart only when the reader pauses, where a phase reset is
		 * invisible. Restarting mid-scroll would stutter.
		 */
		const spine = document.querySelector<HTMLElement>('.spine');
		const rail = document.querySelector<HTMLElement>('.spine-rail');
		const line = document.querySelector<HTMLElement>('.spine-line');
		const flare = document.querySelector<HTMLElement>('.spine-flare');
		const start = document.querySelector<HTMLElement>('.spine-start');

		if (spine && rail && line && flare && start) {
			const reduced = matchMedia('(prefers-reduced-motion: reduce)');
			// Travel rate and the bounds it is clamped to.
			//
			// 0.16px/ms is 160px/s — slow enough that the eye can actually follow the
			// flare down the page. It was 0.45 against a 7s ceiling, which on the full
			// 4796px spine worked out at ~745px/s: it crossed a 900px viewport in just
			// over a second, which is a flicker, not a signal travelling a wire.
			//
			// The ceiling is high because it must not bind at full length: at 160px/s
			// the whole spine takes ~30s, and a lower cap would silently accelerate the
			// flare again on long pages, which is the bug this replaces.
			//
			// The floor matters at the other end. Before any scroll the spine is only
			// ~130px, and at rate that is a blink; at the floor it reads as the slow
			// drift the hero cue used to have.
			//
			// The cost is honest: one pass down the full spine takes ~30s, so a reader
			// sitting still waits longer between passes. That is the trade for being
			// able to track it.
			// The travel occupies 92% of the cycle; the tail is the pause before it
			// runs again, which is what stops it reading as a loading shimmer.
			const travel = 0.92;
			const RATE = 0.16; // px per ms
			const MIN = 2600;
			const MAX = 36000;
			const FLARE_MS = 550; // the per-node flash, inside the cycle

			const docY = (el: Element) => el.getBoundingClientRect().top + window.scrollY;

			let top = 0;
			let extent = 0;
			let reached = 0;
			let markers: { offset: number; size: number; el: HTMLElement }[] = [];
			let anims: Animation[] = [];
			let drawn = -1;
			// The length and cycle the running animations were built for — needed to
			// work out where the head is before replacing them.
			let curLength = 0;
			let curDuration = 0;

			function measure() {
				const spineY = docY(spine!);
				top = docY(start!) - spineY;

				markers = [];
				for (const marker of document.querySelectorAll<HTMLElement>(
					'.node .marker, .entry-marker',
				)) {
					// Offsets are relative to the TOP OF THE LINE, not to the spine, so
					// they can be used directly as mask stops and travel fractions.
					// Height is read off the box rather than assumed: section markers are
					// --marker-size and the timeline's are 12px.
					markers.push({
						offset: docY(marker) - spineY - top,
						size: marker.getBoundingClientRect().height,
						el: marker,
					});
				}

				// The spine ends on the last marker's centre, so the line terminates at
				// a node rather than in mid-air.
				const last = markers[markers.length - 1];
				extent = last ? last.offset + last.size / 2 : 0;

				// On the rail, not the line: the beam sizes from these too, and one
				// declaration is what stops the two boxes disagreeing.
				rail!.style.setProperty('--spine-top', `${top}px`);

				// One mask, one transparent band per marker, 2px of clearance either
				// side so the line does not touch the stroke.
				const bands: string[] = [];
				for (const m of markers) {
					bands.push(
						`transparent ${m.offset - 2}px`,
						`transparent ${m.offset + m.size + 2}px`,
						`#000 ${m.offset + m.size + 2}px`,
					);
				}
				const mask = `linear-gradient(to bottom, #000 0px, ${bands.join(', ')})`;
				line!.style.maskImage = mask;
				(line!.style as any).webkitMaskImage = mask;
			}

			function restart(length: number) {
				// Read off the box rather than restated, so --flare-size stays the one
				// place the flare's length is defined.
				const size = flare!.offsetHeight;

				/*
				 * Where the head is RIGHT NOW, in px down the line.
				 *
				 * Every growth rebuilds these animations, and rebuilding used to mean
				 * cancel-and-begin-again: the head vanished mid-run and restarted at the
				 * top of the spine, far above wherever the reader was. Carrying the
				 * position across means growth extends the run it is already on.
				 *
				 * It is the POSITION that carries over, not the progress fraction — the
				 * same fraction of a longer line is a different place on the page, so
				 * keeping the fraction would jump the head forward instead.
				 */
				let pos = -size;
				const master = anims[0];
				if (master && curLength > 0 && curDuration > 0) {
					const phase = (Number(master.currentTime) || 0) % curDuration;
					const prog = Math.min(phase / (curDuration * travel), 1);
					pos = -size + prog * (curLength + size);
				}

				for (const a of anims) a.cancel();
				anims = [];
				if (reduced.matches || length <= 0) {
					curLength = 0;
					return;
				}

				const duration = Math.min(MAX, Math.max(MIN, length / RATE));
				const span = length + size;

				anims.push(
					flare!.animate(
						[
							// Faded at both ends. At the bottom of the page the line ENDS on
							// screen, so the terminus is visible, and stopping dead there
							// reads as a fault rather than as the run finishing.
							{ transform: `translateY(${-size}px)`, opacity: 0, offset: 0 },
							{
								transform: `translateY(${-size + 0.03 * span}px)`,
								opacity: 1,
								offset: travel * 0.03,
							},
							{
								transform: `translateY(${-size + 0.96 * span}px)`,
								opacity: 1,
								offset: travel * 0.96,
							},
							{ transform: `translateY(${length}px)`, opacity: 0, offset: travel },
							{ transform: `translateY(${length}px)`, opacity: 0, offset: 1 },
						],
						{ duration, iterations: Infinity, easing: 'linear' },
					),
				);

				const frac = FLARE_MS / duration;
				for (const m of markers) {
					const at = m.offset;
					if (at < 0 || at > length) continue;
					anims.push(
						m.el.animate(
							[
								{ filter: 'none', offset: 0 },
								{
									filter: 'drop-shadow(0 0 7px var(--accent-regular))',
									offset: Math.min(frac * 0.35, 0.999),
								},
								{ filter: 'none', offset: Math.min(frac, 1) },
								{ filter: 'none', offset: 1 },
							],
							{
								duration,
								/*
								 * Its share of the travel, so it lights as the flare's HEAD
								 * arrives — not its top edge. The head runs from 0 to
								 * length + size, so the fraction is over that, not over
								 * length. With a 20px flare the difference was noise; at
								 * 4.5rem it is 72px, which at 174px/s is nearly half a
								 * second of the flash firing early.
								 */
								delay: (at / (length + size)) * duration * travel,
								iterations: Infinity,
								easing: 'linear',
							},
						),
					);
				}

				// Drop every animation onto the phase the head was already at, so the
				// node flashes stay in step with the head they are timed to.
				const resume =
					Math.min(1, Math.max(0, (pos + size) / span)) * duration * travel;
				for (const a of anims) a.currentTime = resume;

				curLength = length;
				curDuration = duration;
			}

			function grow() {
				const spineY = docY(spine!);
				reached = Math.max(reached, window.scrollY + window.innerHeight - spineY);
				const next = Math.max(0, Math.min(reached - top, extent));
				if (Math.abs(next - drawn) < 1) return false;
				drawn = next;
				rail!.style.setProperty('--spine-drawn', `${drawn}px`);
				return true;
			}

			let idle = 0;
			function settle() {
				window.clearTimeout(idle);
				idle = window.setTimeout(() => restart(drawn), 180);
			}

			function init() {
				measure();
				// Reduced motion gets the whole spine at once and no flare: the line is
				// structure, the travel is the animation.
				if (reduced.matches) {
					reached = Infinity;
				}
				spine!.classList.add('spine-armed');
				grow();
				settle();
			}

			init();

			window.addEventListener(
				'scroll',
				() => {
					if (grow()) settle();
				},
				{ passive: true },
			);

			window.addEventListener('resize', () => {
				measure();
				drawn = -1;
				grow();
				settle();
			});

			// The reveal transition shifts sections by 8px as they land, so offsets
			// measured before that are stale. One re-measure once the last one lands.
			const done = new MutationObserver(() => {
				if (document.documentElement.dataset.revealState === 'done') {
					done.disconnect();
					measure();
					drawn = -1;
					grow();
					settle();
				}
			});
			done.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['data-reveal-state'],
			});
		}
	</script>
</BaseLayout>

<style>
	.spine {
		display: flex;
		flex-direction: column;
		gap: var(--spine-gap);
		position: relative;
	}

	/*
	 * The spine. One line for the whole page rather than a connector per node.
	 * The stubs could never be continuous: each had to fade at a top that met
	 * nothing, and four independent flares read as four devices rather than one
	 * signal travelling a wire.
	 *
	 * The rail is a .wrapper, so it inherits the same max-width, centring and
	 * inline padding as every section — that is what puts the line on the marker
	 * gutter without restating the container's geometry anywhere. The line is an
	 * in-flow block inside it, so its margin-left measures from the CONTENT edge,
	 * the same origin every marker is placed from.
	 */
	.spine-rail {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	/*
	 * The beam is the clip box, and it is --marker-size wide rather than 1px
	 * because the travelling head has lateral bulk. It used to be the line itself
	 * that clipped, which meant nothing could ever be wider than the line.
	 *
	 * Its width is centred on the spine by construction: half a marker in from
	 * the content edge, minus half its own width, so the line inside it lands on
	 * the same x as every marker whatever the two sizes are.
	 */
	.spine-beam {
		--beam-width: var(--marker-size);
		display: none;
		position: relative;
		width: var(--beam-width);
		margin-left: calc(var(--marker-size) / 2 - var(--beam-width) / 2);
		margin-top: var(--spine-top, 0px);
		height: var(--spine-drawn, 0px);
		overflow: hidden;
	}

	/* Drawn only once the controller has measured. With scripting off there is no
	   spine at all, rather than a line of arbitrary length running through the
	   hero — it is decoration, and this is the honest degradation. */
	:global(.spine-armed) .spine-beam {
		display: block;
	}

	.spine-line {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1px;
		transform: translateX(-50%);
		background: var(--rule-color);
	}

	/*
	 * A travelling light: a bloom at the leading edge with a tail drawn back up
	 * the line behind it. Two parts, because they are different shapes — the tail
	 * is on the line and the head has width.
	 *
	 * --flare-size is the one place the length lives: the height, the parked
	 * position and the controller's keyframes all derive from it, and the
	 * controller reads it off the box rather than restating it.
	 */
	.spine-flare {
		--flare-size: 8rem;
		--flare-head: 1.1rem;
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: var(--flare-size);
		transform: translateY(calc(-1 * var(--flare-size)));
	}

	/* The filament: 1px on the line, brightening along its length. This is what
	   keeps the beam anchored to the spine rather than floating over it. */
	.spine-flare::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1px;
		transform: translateX(-50%);
		background: linear-gradient(
			to bottom,
			transparent 0%,
			color-mix(in srgb, var(--accent-regular) 30%, transparent) 45%,
			color-mix(in srgb, var(--accent-regular) 70%, transparent) 80%,
			var(--accent-regular) 90%,
			transparent 100%
		);
	}

	/*
	 * The halo. Two separate gradients doing two separate jobs, which is what
	 * finally makes it a beam:
	 *
	 *   background   the profile ALONG the beam — where its mass sits
	 *   mask         the falloff ACROSS it — the soft sides
	 *
	 * A single radial gradient could do neither properly. It falls off equally in
	 * both directions from its centre, so the beam was symmetric head to tail
	 * however the stops were tuned; and its vertical radius reached past the
