---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { computeUrl } from '../utils/computeUrl';

const allWork = await getCollection('work');

const timeline = [
	{
		company: 'Adobis Group',
		role: 'Tech Lead & Full-Stack Developer',
		location: 'Grenoble, France',
		period: 'Aug 2021 – Present',
		description: 'Leading a team of 5 developers building enterprise platforms with Angular micro-frontends, Spring Boot back-ends, and DDD/Hexagonal architecture.',
		slugs: ['workflow', 'formula-editor', 'migration', 'dev-training', 'keycloak', 'ddd-architecture', 'design-system', 'nx-monorepo'],
	},
	{
		company: 'Capgemini-Sogeti High Tech',
		role: 'Full-Stack Consultant',
		location: 'Grenoble, France',
		period: 'Jul 2018 – Aug 2021',
		description: 'Consulting for Schneider Electric (Wiser Energy — IoT, solar monitoring, home automation) and EATON (IPM2 — data center UPS monitoring with Angular/NgRx).',
		slugs: ['wiser-energy', 'ipm2'],
	},
	{
		company: 'VISEO Technologies',
		role: 'Full-Stack Consultant',
		location: 'Grenoble, France',
		period: 'Mar 2017 – Jun 2018',
		description: 'Worked on the SPARK project with Politecnico di Milano — Spatial Augmented Reality with real-time 3D projection on physical models.',
		slugs: ['spark-ar'],
	},
];

const education = [
	{ title: 'Java Software Developer Bootcamp', institution: 'M2I, Grenoble', period: '2016 – 2017' },
	{ title: 'PhD in Computational Material Science', institution: 'Université de Poitiers / Institut Pprime', period: '2012 – 2016' },
	{ title: 'Masters in Particle Physics', institution: 'Université Grenoble Alpes', period: '2009 – 2012' },
];

function getWorkBySlug(slug: string) {
	return allWork.find((w) => w.id === slug);
}
---

<BaseLayout title="Timeline | Francois ABED EL NABI" description="Career timeline of Francois ABED EL NABI">
	<div class="stack gap-20">
		<main class="wrapper">
			<Hero
				title="Timeline"
				tagline="My career journey from physics research to software engineering."
			/>

			<div class="timeline">
				{timeline.map((entry) => (
					<div class="timeline-entry">
						<div class="timeline-marker">
							<div class="timeline-dot" />
						</div>
						<div class="timeline-content">
							<div class="timeline-header">
								<h2>{entry.company}</h2>
								<span class="timeline-period">{entry.period}</span>
							</div>
							<p class="timeline-role">{entry.role} — {entry.location}</p>
							<p class="timeline-description">{entry.description}</p>
							{entry.slugs.length > 0 && (
								<div class="timeline-achievements">
									<h3>Key Achievements</h3>
									<div class="achievement-links">
										{entry.slugs.map((slug) => {
											const work = getWorkBySlug(slug);
											return work ? (
												<a href={computeUrl(`/work/${slug}/`)} class="achievement-pill">
													{work.data.title}
												</a>
											) : null;
										})}
									</div>
								</div>
							)}
						</div>
					</div>
				))}

				<div class="timeline-entry">
					<div class="timeline-marker">
						<div class="timeline-dot education-dot" />
					</div>
					<div class="timeline-content">
						<div class="timeline-header">
							<h2>Education</h2>
							<span class="timeline-period">2009 – 2017</span>
						</div>
						<div class="education-list">
							{education.map((edu) => (
								<div class="education-item">
									<p class="education-title">{edu.title}</p>
									<p class="education-detail">{edu.institution} — {edu.period}</p>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.timeline {
		position: relative;
		margin-top: 3rem;
		padding-left: 3rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: calc(0.4375rem - 1px);
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--gradient-accent-orange);
	}

	.timeline-entry {
		position: relative;
		padding-bottom: 3rem;
	}

	.timeline-entry:last-child {
		padding-bottom: 0;
	}

	.timeline-marker {
		position: absolute;
		left: -3rem;
		top: 0.3rem;
	}

	.timeline-dot {
		width: 0.875rem;
		height: 0.875rem;
		border-radius: 50%;
		background: var(--accent-regular);
		border: 3px solid var(--gray-999);
		box-shadow: 0 0 0 2px var(--accent-regular);
		z-index: 1;
		animation: dot-entrance 0.5s ease-out both;
	}

	.timeline-entry:nth-child(1) .timeline-dot { animation-delay: 0s; }
	.timeline-entry:nth-child(2) .timeline-dot { animation-delay: 0.15s; }
	.timeline-entry:nth-child(3) .timeline-dot { animation-delay: 0.3s; }
	.timeline-entry:nth-child(4) .timeline-dot { animation-delay: 0.45s; }

	@keyframes dot-entrance {
		0% { transform: scale(0); opacity: 0; }
		70% { transform: scale(1.3); }
		100% { transform: scale(1); opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.timeline-dot {
			animation: none;
		}
	}

	.education-dot {
		background: var(--gray-300);
		box-shadow: 0 0 0 2px var(--gray-300);
	}

	.timeline-content {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border-inline-start: 2px solid transparent;
		padding-inline-start: 0.75rem;
		transition: border-color var(--transition-medium);
	}

	.timeline-entry:hover .timeline-content {
		border-color: var(--accent-regular);
	}

	.timeline-header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.timeline-header h2 {
		font-size: var(--text-xl);
		color: var(--gray-0);
		margin: 0;
	}

	.timeline-period {
		font-size: var(--text-sm);
		color: var(--accent-regular);
		font-weight: 600;
		font-family: var(--font-brand);
	}

	.timeline-role {
		font-size: var(--text-md);
		color: var(--gray-200);
		margin: 0;
	}

	.timeline-description {
		color: var(--gray-300);
		margin: 0;
		line-height: 1.6;
	}

	.timeline-achievements {
		margin-top: 0.5rem;
	}

	.timeline-achievements h3 {
		font-size: var(--text-sm);
		color: var(--gray-200);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0 0 0.5rem;
	}

	.achievement-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.achievement-pill {
		display: inline-block;
		padding: 0.35rem 0.85rem;
		font-size: var(--text-sm);
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		border: 1px solid var(--accent-regular);
		border-radius: 999rem;
		text-decoration: none;
		transition: background-color var(--theme-transition), color var(--theme-transition);
		white-space: nowrap;
	}

	.achievement-pill:hover,
	.achievement-pill:focus {
		background-color: transparent;
		color: var(--accent-regular);
	}

	.education-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.education-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.education-title {
		color: var(--gray-100);
		font-weight: 600;
		margin: 0;
	}

	.education-detail {
		color: var(--gray-400);
		font-size: var(--text-sm);
		margin: 0;
	}

	@media (min-width: 50em) {
		.timeline {
			padding-left: 3.5rem;
			margin-top: 4rem;
		}

		.timeline::before {
			left: calc(0.4375rem - 1px);
		}

		.timeline-marker {
			left: -3.5rem;
		}

		.timeline-header {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
		}

		.timeline-header h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
