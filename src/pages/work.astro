---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Hero from '../components/Hero.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const companies = [
	{ value: 'all', label: 'All' },
	{ value: 'adobis', label: 'Adobis Group' },
	{ value: 'capgemini', label: 'Capgemini' },
	{ value: 'viseo', label: 'VISEO' },
];
---

<BaseLayout
	title="My Work | Francois ABED EL NABI"
	description="Learn about Francois ABED EL NABI's most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="My Work"
				tagline="See my most recent projects below to get an idea of my past experience."
				align="start"
			/>
			<div class="filters" role="group" aria-label="Filter by company">
				{companies.map((c) => (
					<button
						class:list={['filter-pill', { active: c.value === 'all' }]}
						data-filter={c.value}
					>
						{c.label}
					</button>
				))}
			</div>
			<ul class="work-grid">
				{
					projects.map((project) => (
						<li data-company={project.data.company || ''}>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</ul>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<script>
	const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
	const items = document.querySelectorAll<HTMLLIElement>('.work-grid > li');

	pills.forEach((pill) => {
		pill.addEventListener('click', () => {
			const filter = pill.dataset.filter;

			pills.forEach((p) => p.classList.remove('active'));
			pill.classList.add('active');

			items.forEach((item) => {
				if (filter === 'all' || item.dataset.company === filter) {
					item.style.display = '';
				} else {
					item.style.display = 'none';
				}
			});
		});
	});
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.filter-pill {
		cursor: pointer;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		padding: 0.4rem 1rem;
		border-radius: 999rem;
		border: 1px solid var(--gray-800);
		background: var(--gray-999);
		color: var(--gray-300);
		transition: all var(--theme-transition), transform var(--transition-fast), box-shadow var(--transition-fast);
	}

	.filter-pill:hover {
		border-color: var(--accent-regular);
		color: var(--gray-100);
		transform: translateY(-1px);
		box-shadow: var(--shadow-sm);
	}

	.filter-pill.active {
		background: var(--accent-regular);
		border-color: var(--accent-regular);
		color: var(--accent-text-over);
		box-shadow: var(--shadow-sm);
	}

	.work-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		list-style: none;
		padding: 0;
	}

	@media (min-width: 50em) {
		.work-grid {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
		}
	}
</style>
